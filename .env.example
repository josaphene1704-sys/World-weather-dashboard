# Copy to .env and fill in your key from https://weatherstack.com/dashboard
WEATHERSTACK_API_KEY=your_api_key_here

# Optional: mirror each refresh into Airtable (table "Weather").
# Personal access token from https://airtable.com/create/tokens with scopes data.records:write + data.records:read
AIRTABLE_API_KEY=your_airtable_token_here
AIRTABLE_BASE_ID=appXCtJG4rYhhbv4Z
AIRTABLE_TABLE=Weather
